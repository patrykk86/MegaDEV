# Root gitignore for MegaDEV workspace
.env
.env.*
!.env.example
.agents/
__pycache__/
*.py[cod]
*.log
requests.log
node_modules/
.audits/
.runs/
.copilot/
.gemini/
.cline/*
# the project-level MCP declaration is tracked on purpose, so this negation keeps it in view
!.cline/mcp.json
tools/gateway/node_modules
# mega-examples is an independent cloned git repository (updated via `git -C mega-examples pull`)
/mega-examples/
# Challenge archives and extracted payloads
*.zip
*.tar.gz
s[0-9][0-9]e[0-9][0-9]/*.zip
s[0-9][0-9]e[0-9][0-9]/starter/
s[0-9][0-9]e[0-9][0-9]/sessions/
s[0-9][0-9]e[0-9][0-9]/sessions-archive.json
s[0-9][0-9]e[0-9][0-9]/requests.log
s[0-9][0-9]e[0-9][0-9]/job-[0-9]*/
.aider*
# KEEP.md is a machine-local hand-off note; its Can run block records absolute tool paths
/KEEP.md
# Copied agent-brain transcripts are machine-local knowledge, never committed
/memory/antigravity-brain/
s03e01/transcript.md
s03e01/lesson-raw.txt
s03e01/brain-knowledge.md
memory/MEMORY.md
s03e01/inbox-raw.json
s03e01/lesson.md
s03e01/LESSON-NOTES.md
s03e01/pack/
s02e03/firebase/
# Local hand-off clone: rig carries a .git of its own, so a nested copy here is never
# source for this repo (same reasoning as /mega-examples/ above)
/rig-handover/
# Downloaded tool binaries and captured media: regenerable, and occasionally very large
*.exe
*.mp3
*.mp4
*.m4a
*.wav
*.webm
*.mov
# Firebase CLI deploy cache and debug logs
**/.firebase/
firebase-debug.log*
# Harness runtime state: durable suspensions and inbound drops never belong in history
/.approvals/
/data/inbound/
**/.processed_messages.json
# Server runtime state and uploaded payloads; the .gitkeep markers keep the folders
s[0-9][0-9]e[0-9][0-9]/data/store.json
s[0-9][0-9]e[0-9][0-9]/data/files/*
!s[0-9][0-9]e[0-9][0-9]/data/files/.gitkeep
# pytest writes its own cache here even though the workspace toolchain is Node
/.pytest_cache/
# Build output, coverage and OS/editor noise
**/.svelte-kit/
**/.next/
**/dist/
**/coverage/
.nyc_output/
*.tsbuildinfo
.DS_Store
Thumbs.db
desktop.ini
*.pid
*.tmp
*.bak
*.orig

